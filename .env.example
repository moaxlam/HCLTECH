# Copy to .env and adjust. No secret belongs in this file or in the repository.
# Nothing reads this file automatically: start the API with
#   uvicorn assa.api:app --env-file .env --port 8000
# or export the variables in your shell.

# --- LLM -------------------------------------------------------------------
# LLM Provider: "groq" or "ollama" (auto-detected: defaults to "groq" if GROQ_API_KEY is set)
ASSA_LLM_PROVIDER=groq

# Groq Cloud LLM (recommended models: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local Ollama (if using local models instead of Groq)
OLLAMA_HOST=http://localhost:11434
ASSA_OLLAMA_MODEL=llama3.1:8b
ASSA_LLM_TIMEOUT_S=120

# MOCK_LLM=true runs the whole pipeline with no model at all (deterministic
# classification, tool selection, composition and grounding checks).
MOCK_LLM=false

# Optional secondary cloud fallback, disabled by default.
ASSA_CLOUD_FALLBACK=false
ASSA_CLOUD_BASE_URL=
ASSA_CLOUD_API_KEY=
ASSA_CLOUD_MODEL=

# --- Retrieval -------------------------------------------------------------
ASSA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Test-only deterministic embedder; never the default in a deployed setting.
# ASSA_EMBEDDING_PROVIDER=hash
ASSA_TOP_K=6
ASSA_CHUNK_MAX_CHARS=1400
ASSA_CHUNK_OVERLAP_CHARS=150
# Relevance floor: a chunk below this similarity is not used as evidence.
# 0.55 was measured on this corpus (answerable questions 0.587-0.836, unanswerable
# 0.354-0.495 with all-MiniLM-L6-v2). See evaluation/comparison.md.
ASSA_MIN_SCORE=0.55

# --- Storage ---------------------------------------------------------------
ASSA_DATA_DIR=/app/data
ASSA_SQLITE_PATH=/app/data/university.db
ASSA_CHROMA_DIR=/app/data/chroma
ASSA_DOCUMENTS_DIR=/app/documents

# Qdrant Vector Store (optional)
QDRANT_URL=
QDRANT_API_KEY=

# --- API -------------------------------------------------------------------
ASSA_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080
ASSA_LOG_LEVEL=INFO
